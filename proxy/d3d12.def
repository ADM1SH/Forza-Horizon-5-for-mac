; Export list for the d3d12.dll proxy. Each export is a small jump thunk in d3d12_proxy.c that
; goes to the same function in the provider copy apd12.dll.
; Names and ordinals 100 to 111 come from the provider's own export table (checked 05/11/2026).
; The game imports ordinal 101 (D3D12CreateDevice) and D3D12SerializeVersionedRootSignature.
; Forwarder exports do not work here: run 1b of set 18 (06/11/2026) crashed when the game ran
; the forwarder entry of D3D12CreateDevice as code.
; License: MIT (see LICENSE).
LIBRARY d3d12.dll
EXPORTS
    GetBehaviorValue @100
    D3D12CreateDevice @101
    D3D12GetDebugInterface @102
    D3D12CoreCreateLayeredDevice @103
    D3D12CoreGetLayeredDeviceSize @104
    D3D12CoreRegisterLayers @105
    D3D12CreateRootSignatureDeserializer @106
    D3D12CreateVersionedRootSignatureDeserializer @107
    D3D12EnableExperimentalFeatures @108
    D3D12GetInterface @109
    D3D12SerializeRootSignature @110
    D3D12SerializeVersionedRootSignature @111
